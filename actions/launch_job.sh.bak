#!/bin/bash
# 
#

#[[ "$CMD_CATEGORY" == "spcx-hosts" ]] || exit 0


#sleep 5

source /etc/profile.d/modules.sh
module load slurm
## set path
home=/home/cmods/bringup
quickview=$home/results/$HOSTNAME/quick-view.txt

## Check if node is in slurm
state=$(sinfo -N -n "$HOSTNAME" -h -o '%T')

## Save if needed for partition view later
#state=$(sinfo -p validation -N -n "$HOSTNAME" -h -o '%T')
#partition=$(sinfo -Nh -n $HOSTNAME -o '%R' | grep validation)

#if [[ -z "$partition" ]]; 
#then
#	echo hi
#	exit 0
#fi

######## Examples of job checks
# if [[ "$state" == "idle" ]];
# if [[ "$state" == "idle" || "$state" == "mixed" || "$state" == "allocated" ]];
# if [[ "$state" == "idle" || "$state" == "mixed" || "$state" == "allocated" ]] && [[ ! -s "/home/cmods/bringup/results/$HOSTNAME/ib.txt" ]];
########

## Check if node is in slurm; if not - quit
if [[ -z "$state" ]]
then
	exit 0
fi

## rework - for jobs in job1 job2 job3 do format1 

## Job format for jobs that run alone

for job in hostname_1node ib_2node;
do

checks=$home/results/$HOSTNAME/$job.txt
state=$(sinfo -N -n "$HOSTNAME" -h -o '%T')

if [[ "$state" == "idle" ]];
then
	if [[ $(tail -1 $checks) == "FAIL" ]];
	then
		scontrol update nodename="$HOSTNAME" state=DRAIN reason="$job FAIL"
	elif [[ $(tail -1 $checks) == "DONE" ]];
	then
		if ! grep -q -- $job $quickview ]];
		then
			echo "$job:               DONE" >> $quickview
		else
			echo DONE
		fi
	else
		su - cmods -c "source /etc/profile.d/modules.sh; module load slurm; sbatch -w $HOSTNAME $home/jobs/$job.sh"
	fi
fi

sleep 5
done

