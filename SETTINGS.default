## Shipped defaults for this framework. Read by settings.sh when there is no
## SETTINGS file next to it. See docs/settings.md for the full reference.
##
## To change anything here, copy this file to SETTINGS and edit that. SETTINGS
## is git-ignored and is never written by a tarball drop, so a site's choices
## survive an upgrade; editing this file in place does not.
##
##   cp SETTINGS.default SETTINGS

## ── Job sets ──────────────────────────────────────────────────────────────
JOBS=nvl72
HEALTHCHECKS=nvl72
PARSERS=nvl72

## ── Benchmark list ────────────────────────────────────────────────────────
## Order matters: nvbandwidth reports a fabric problem in half an hour, before
## the collectives spend longer rediscovering it.
BENCHMARKS="dcgm nvbandwidth allreduce alltoall allreduce-nonvlink \
            alltoall-nonvlink"

## ── Burn-in ───────────────────────────────────────────────────────────────
## A second phase, queued only once every job in BENCHMARKS passes, and only
## when RUN_BURNIN says so. Burn-in holds a node for days, so it is a decision
## rather than a default: the sweep answers "does this node work", and burn-in
## answers "does it keep working", which is a question worth asking after the
## first one has been answered and not before.
RUN_BURNIN=no
BURNIN="mnubergemm"

## ── Container images ──────────────────────────────────────────────────────
## nvbandwidth and mnubergemm come from a private NGC org -- run
## `./build_containers.sh -L` once on the head node, or the images do not
## arrive and the two jobs that need them fail on every node. See
## docs/containers.md.
CONTAINERS="hpc-benchmarks nvbandwidth mnubergemm"

## ── Pause switches ────────────────────────────────────────────────────────
## Stop the framework doing anything, without unregistering it from BCM. The
## triggers keep firing; each action reads these and returns having done
## nothing, saying so in its trace. See docs/operations.md#pausing-everything.
PAUSE_JOBS=no
PAUSE_HEALTH_CHECKS=no
PAUSE_CONTAINER_COPY=no

## ── Drains ────────────────────────────────────────────────────────────────
DRAIN_AFTER_FAILED_HEALTH_CHECK=no
DRAIN_AFTER_FAILED_BENCHMARK=no

## ── Retry and drain policy ────────────────────────────────────────────────
RETRY_INTERVAL_HOURS=1
## Above the longest single run in BENCHMARKS *and* BURNIN, which is
## mnubergemm's 6:30:00 step -- a job still RUNNING past this drains the node
## for timeout, so a value below it drains healthy nodes for finishing on
## schedule. The ladder is workload 5:57 < srun 6:30 < sbatch -t 6:41 < this.
MAX_JOB_HOURS=7
DRAIN_WINDOW_MINUTES=15
DRAIN_MARKER="auto-retry"

## ── Accounts and paths ────────────────────────────────────────────────────
JOB_USER=cmods
BRINGUP_HOME=/home/cmods/bringup
