## Shipped defaults for this framework. Read by settings.sh when there is no
## SETTINGS file next to it. See docs/settings.md for the full reference.
##
## To change anything here, copy this file to SETTINGS and edit that. SETTINGS
## is git-ignored and is never written by a tarball drop, so a site's choices
## survive an upgrade; editing this file in place does not.
##
##   cp SETTINGS.default SETTINGS

## ── Job sets ──────────────────────────────────────────────────────────────
JOBS=nvl72
HEALTHCHECKS=nvl72
PARSERS=nvl72

## ── Benchmark list ────────────────────────────────────────────────────────
BENCHMARKS="dcgm nvbandwidth allreduce alltoall allreduce-nonvlink alltoall-nonvlink"

## ── Burn-in ───────────────────────────────────────────────────────────────
RUN_BURNIN=no
BURNIN="mnubergemm"

## ── Container images ──────────────────────────────────────────────────────
CONTAINERS="hpc-benchmarks nvbandwidth mnubergemm"

## ── Pause switches ────────────────────────────────────────────────────────
PAUSE_JOBS=no
PAUSE_HEALTH_CHECKS=no
PAUSE_CONTAINER_COPY=no

## ── Drains ────────────────────────────────────────────────────────────────
DRAIN_AFTER_FAILED_HEALTH_CHECK=no
DRAIN_AFTER_FAILED_BENCHMARK=no

## ── Recovering drains Slurm set itself ────────────────────────────────────
RECOVER_SLURM_DRAINS=yes
RECOVER_REASONS="prolog|epilog|rogue ?process|batch job complete failure|Kill task failed|node unexpectedly rebooted"
RECOVER_EMPTY_REASON=yes
RECOVER_SETTERS="slurm root"
RECOVER_MAX_ATTEMPTS=3
RECOVER_WINDOW_HOURS=24
RECOVER_RESTART_SLURMD=no

## ── Retry and drain policy ────────────────────────────────────────────────
RETRY_INTERVAL_HOURS=1
MAX_JOB_HOURS=7
DRAIN_WINDOW_MINUTES=15
DRAIN_MARKER="auto-retry"

## ── Extra environment for every benchmark job ─────────────────────────────
##   JOB_ENV="NCCL_DMABUF_ENABLE=0 NCCL_CUMEM_ENABLE=1"
JOB_ENV=""

## ── Accounts and paths ────────────────────────────────────────────────────
JOB_USER=cmods
BRINGUP_HOME=/home/cmods/bringup
