[Unit]
Description=Bring-up watchdog: arm the node agent wherever its heartbeat has gone stale
Documentation=file://@BRINGUP_HOME@/docs/explanation/the-agent-and-the-watchdog.md

[Service]
Type=oneshot
# A login shell, not the script directly: systemd gives a service a minimal
# PATH and reads no profile, so `scontrol` is missing on exactly the hosts
# where it works when you log in. See
# docs/how-to/run-slurm-commands-remotely.md.
ExecStart=/bin/bash -lc "@BRINGUP_HOME@/agent/supervisor.sh --quiet"
# One pdsh across the fleet, plus its ssh timeouts.
TimeoutStartSec=900
